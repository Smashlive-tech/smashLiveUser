{
  "expo": {
    "name": "SmashLive",
    "slug": "smashLiveUser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smashLiveLogo.png",
    "scheme": "smashliveuser",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sai-nath.smashLiveUser",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/smashLiveLogo.png",
        "backgroundImage": "./assets/images/smashLiveLogo.png",
        "monochromeImage": "./assets/images/smashLiveLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sai_nath.smashLiveUser"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smashLiveLogo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/smashLiveLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SmashLive to use your location."
        }
      ]
    ],
    
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8c83c26-b766-4868-a6a3-e2894cc86bee"
      }
    }
  }
}
